# ── LLM Provider ─────────────────────────────────────────────────────────────
# Set to "groq" or "gemini". If no key is set, MockLLMClient is used (for tests).
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# OR use Gemini:
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=quickdrop
POSTGRES_PASSWORD=quickdrop
POSTGRES_DB=disputes
DATABASE_URL=postgresql+asyncpg://quickdrop:quickdrop@postgres:5432/disputes
DATABASE_URL_SYNC=postgresql://quickdrop:quickdrop@postgres:5432/disputes

# ── PaySwift ──────────────────────────────────────────────────────────────────
# Set automatically by docker-compose to point to payswift service
PAYSWIFT_BASE_URL=http://payswift:8081

# ── Application ───────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
